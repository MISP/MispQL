{
  "plan": "SearchPlan",
  "table": "galaxy_clusters",
  "endpoint": "/galaxy_clusters/restSearch",
  "body": {
    "returnFormat": "json",
    "limit": 5,
    "page": 1,
    "order": [
      "value asc"
    ],
    "query": {
      "AND": [
        {
          "meta.synonyms": {
            "LIKE": "%fancy%"
          }
        },
        {
          "NOT": {
            "meta.Additional Content Note": "x"
          }
        },
        {
          "meta.access_privilege.rule_effect": {
            "IN": [
              "permit",
              "deny"
            ]
          }
        }
      ]
    }
  },
  "output": "default",
  "columns": [
    "id",
    "value",
    "galaxy.name"
  ],
  "skip": 0,
  "spans": {
    "query": "meta.synonyms LIKE '%fancy%' AND NOT meta.`Additional Content Note` = 'x' AND galaxy_clusters.meta.access_privilege.rule_effect IN ('permit', 'deny')",
    "query.AND[0]": "meta.synonyms LIKE '%fancy%'",
    "query.AND[0].<unknown>": "meta.synonyms",
    "query.AND[1]": "NOT meta.`Additional Content Note` = 'x'",
    "query.AND[1].NOT": "meta.`Additional Content Note` = 'x'",
    "query.AND[1].NOT.<unknown>": "meta.`Additional Content Note`",
    "query.AND[2]": "galaxy_clusters.meta.access_privilege.rule_effect IN ('permit', 'deny')",
    "query.AND[2].<unknown>": "galaxy_clusters.meta.access_privilege.rule_effect",
    "order[0]": "value"
  }
}
